      "31776it [01:26, 367.09it/s, batch: 1 | bound: 2 | nc: 1 | ncall: 640404 | eff(%):  4.643 | loglstar: -1.992 < -0.003 < -0.556 | logz: -9.319 +/-  0.067 | stop:  0.723]                       "
     ]
