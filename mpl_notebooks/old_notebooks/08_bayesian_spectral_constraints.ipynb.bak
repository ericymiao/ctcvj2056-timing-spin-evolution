   "source": [
    "# Bayesian Inference with Spectral Constraints: CTCV J2056-3014\n",
    "\n",
    "This notebook extends the analysis from `07_bayesian_inference.ipynb` by incorporating X-ray spectral constraints ($L_X$ and $kT_{\\text{max}}$) directly into the likelihood. This addresses the M–$\\dot{M}$ prior correlation from spectral fitting (Salcedo+2024) by replacing informative spectral mass priors with broad population priors, and letting the spectral observables constrain the parameters through the physics.\n",
    "\n",
    "**Data sources:**\n",
    "- $\\dot{P}_{\\rm obs} = 0.0 \\pm 1.7 \\times 10^{-15}$ s/s (Salcedo+2024, Section 3.3)\n",
    "- $L_X = 1.8 \\times 10^{31}$ erg/s (0.3–12 keV, low state; Salcedo+2024)\n",
    "- $kT_{\\rm max} = 16.3^{+1.9}_{-1.8}$ keV (MKCFLOW; Salcedo+2024, Table 6)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "from scipy.interpolate import interp1d\n",
    "from scipy.stats import norm\n",
    "import matplotlib.pyplot as plt\n",
    "import corner\n",
    "import dynesty\n",
    "from dynesty import utils as dyfunc\n",
    "from dynesty import plotting as dyplot\n",
    "\n",
    "plt.rcParams.update({\n",
    "    'font.size': 13,\n",
    "    'axes.labelsize': 13,\n",
    "    'xtick.labelsize': 13,\n",
    "    'ytick.labelsize': 13,\n",
    "    'xtick.direction': 'in',\n",
    "    'ytick.direction': 'in',\n",
    "    'xtick.top': True,\n",
    "    'ytick.right': True,\n",
    "    'xtick.minor.visible': True,\n",
    "    'ytick.minor.visible': True,\n",
    "    'figure.constrained_layout.use': True,\n",
    "})\n",
    "\n",
    "savedir = '../paper_figures' "
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Constants, Data, and WD Mass-Radius-Inertia Relation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Table range: 0.010 - 1.406 Msun\n",
      "L_X_obs = 1.80e+31 erg/s  (sigma = 1.36e+30)\n",
      "kT_obs  = 16.3 +/- 1.15 keV (1-sigma)\n"
     ]
    }
   ],
   "source": [
    "# --- Physical constants (CGS) ---\n",
    "G = 6.674e-8       # cm^3 g^-1 s^-2\n",
    "Msun = 1.989e33    # g\n",
    "Rsun = 6.957e10    # cm\n",
    "m_H = 1.6726e-24   # proton mass [g]\n",
    "keV_to_erg = 1.602e-9  # keV -> erg\n",
    "\n",
    "# --- Measured timing data (1-sigma) ---\n",
    "P = 29.609685843       # spin period [s]\n",
    "Pdot_obs = 0.0         # observed Pdot [s/s]\n",
    "sigma_Pdot = 1.7e-15   # 1-sigma uncertainty on Pdot [s/s]\n",
    "\n",
    "# --- Spectral observables (Salcedo+2024) ---\n",
    "# X-ray luminosity: F_X(unabs, 0.3-12 keV) = 2.2e-12 erg/s/cm^2, d = 261.6 +/- 7.4 pc\n",
    "d_pc = 261.6                           # distance [pc]\n",
    "sigma_d_pc = 7.4                       # 1-sigma distance error [pc]\n",
    "d_cm = d_pc * 3.086e18                 # distance [cm]\n",
    "F_X = 2.2e-12                          # unabsorbed flux [erg/s/cm^2]\n",
    "sigma_FX_frac = 0.05                   # ~5% flux uncertainty (spectral fit)\n",
    "L_X_obs = 4 * np.pi * d_cm**2 * F_X   # X-ray luminosity [erg/s], 0.3-12 keV band\n",
    "# Propagate distance + flux uncertainties\n",
    "sigma_LX = L_X_obs * np.sqrt((2 * sigma_d_pc / d_pc)**2 + sigma_FX_frac**2)\n",
    "\n",
    "# X-ray band for the bolometric -> band-limited correction applied to L_X_pred\n",
    "LX_BAND_LO = 0.3   # keV\n",
    "LX_BAND_HI = 12.0  # keV\n",
    "\n",
    "# kT_max from MKCFLOW (Salcedo+2024, Table 6)\n",
    "# 90% CI: 16.3 +1.9/-1.8 keV -> 1-sigma ~ 1.9/1.645 ~ 1.15 keV\n",
    "kT_obs = 16.3        # keV\n",
    "sigma_kT = 1.15       # 1-sigma [keV]\n",
    "\n",
    "# Mean molecular weight for fully ionized solar-composition plasma\n",
    "mu_mol = 0.617\n",
    "# Empirical correction factor (Yu+2018, calibrated on 11 nmCVs)\n",
    "alpha_Yu = 0.646\n",
    "\n",
    "# --- Load WD mass-radius-inertia table ---\n",
    "mr_data = np.loadtxt('../wd_mass_radius/mass_radius.txt', delimiter=',', skiprows=1)\n",
    "M_table = mr_data[:, 0]   # M_sun\n",
    "R_table = mr_data[:, 1]   # R_sun\n",
    "I_table = mr_data[:, 2]   # g cm^2\n",
    "\n",
    "# Interpolators: input in solar masses, output in CGS\n",
    "get_R = interp1d(M_table, R_table * Rsun, kind='cubic')   # returns cm\n",
    "get_I = interp1d(M_table, I_table, kind='cubic')           # returns g cm^2\n",
    "\n",
    "M_min_table = M_table.min()\n",
    "M_max_table = M_table.max()\n",
    "\n",
    "# --- Magnetosphere geometry ---\n",
    "# xi:  magnetospheric-radius prefactor, r_m = xi * r_Alfven (Ghosh & Lamb 1979).\n",
    "#      xi = 0.5 is the conventional disk-accretion value; literature range ~0.2-1.\n",
    "#      Since r_m ~ B^(4/7), the inferred B scales as xi^(-7/4); a factor-2\n",
    "#      uncertainty in xi maps to ~3.4x on B. Quantified as a systematic in the\n",
    "#      appendix by rerunning the inference at xi = 0.3 and xi = 1.0.\n",
    "# eta: accretion-efficiency factor in the propeller regime (Bhattacharyya &\n",
    "#      Chakrabarty 2017, their Eq 10). eta = 1 assumes full coupling between\n",
    "#      ejected material and the magnetosphere. The posterior is insensitive to\n",
    "#      eta because the spectral likelihoods (kT, L_X) force the posterior into\n",
    "#      the accretion branch (r_m < r_co), so only Pdot is sensitive to eta.\n",
    "xi  = 0.5\n",
    "eta = 1.0\n",
    "\n",
    "print(f\"Table range: {M_min_table:.3f} - {M_max_table:.3f} Msun\")\n",
    "print(f\"L_X_obs = {L_X_obs:.2e} erg/s  (sigma = {sigma_LX:.2e})\")\n",
    "print(f\"kT_obs  = {kT_obs:.1f} +/- {sigma_kT:.2f} keV (1-sigma)\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Forward Models\n",
    "\n",
    "**Pdot** models implement Bhattacharyya & Chakrabarty (2017, Eqs. 9-10). The IP torque uses a propeller-efficiency factor $\\eta = 1$ (documented as a constant in the constants cell).\n",
    "\n",
    "**Spectral forward models:**\n",
    "\n",
    "*nmCV:*\n",
    "- $kT_{\\text{pred}} = \\frac{3}{16} \\alpha \\mu_{\\text{mol}} m_H \\frac{GM}{R}$ (Yu+2018, $\\alpha = 0.646$)\n",
    "- $L_{X,\\text{pred}} = f_{\\rm band}(kT_{\\rm pred}) \\cdot \\frac{GM\\dot{M}}{R}$\n",
    "\n",
    "*IP:*\n",
    "- $kT_{\\text{pred}} = \\frac{3}{8} \\mu_{\\text{mol}} m_H \\cdot 2GM\\left(\\frac{1}{R} - \\frac{1}{r_m}\\right)$ (compact shock approximation)\n",
    "- $L_{X,\\text{pred}} = f_{\\rm band}(kT_{\\rm pred}) \\cdot GM\\dot{M}\\left(\\frac{1}{R} - \\frac{1}{r_m}\\right)$\n",
    "\n",
    "**Band correction.** Theoretical accretion luminosities are bolometric, whereas $L_{X,\\rm obs}$ is the unabsorbed flux in 0.3-12 keV. For single-temperature thermal bremsstrahlung with Gaunt factor $g_{\\rm ff} \\approx 1$, the band fraction is\n",
    "$$f_{\\rm band}(kT) = \\exp(-E_{\\rm lo}/kT) - \\exp(-E_{\\rm hi}/kT),$$\n",
    "evaluated at the model $kT_{\\rm pred}$ so the correction is self-consistent with the predicted spectral shape. At $kT \\sim 16$ keV this gives $f_{\\rm band} \\approx 0.5$, i.e. about half the bolometric accretion luminosity falls in the observed band.\n",
    "\n",
    "**Propeller rejection (IP).** In the propeller regime ($r_m > r_{\\rm co}$) material is centrifugally ejected and a standing accretion shock on the WD surface is physically absent. $kT_{\\rm ip}$ and $L_{X,\\rm ip}$ therefore return NaN when $r_m > r_{\\rm co}$ (log-likelihood $\\to -\\infty$), so the spectral observables force the posterior into the accretion branch. The Pdot forward model still evaluates in both regimes — only the spectral predictions are suppressed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== Pdot checks ===\n",
      "nmCV(0.935, 15): Pdot = -2.381e-16\n",
      "IP(0.815, 15, 30.3): Pdot = -3.262e-16\n",
      "\n",
      "=== f_band checks ===\n",
      "f_band(16.3 keV): 0.503   (0.3-12 keV fraction at kT_obs)\n",
      "f_band(10 keV):   0.669\n",
      "f_band(30 keV):   0.320\n",
      "\n",
      "=== kT checks ===\n",
      "nmCV kT(0.9): 15.7 keV  (expect ~15-20 keV)\n",
      "IP kT(0.8, 14.5, 30.0): 17.9 keV  (accretion regime)\n",
      "IP kT(0.8, 14.5, 31.0): nan   (propeller regime -> NaN expected)\n",
      "\n",
      "=== L_X checks (band-corrected) ===\n",
      "nmCV L_X(0.9, 14.5): 3.28e+31 erg/s  (expect ~5e30-1e31)\n",
      "IP L_X(0.8, 14.5, 30.0): 5.53e+30 erg/s\n"
     ]
    }
   ],
   "source": [
    "# =====================================================\n",
    "# Pdot forward models (Bhattacharyya & Chakrabarty 2017)\n",
    "# =====================================================\n",
    "\n",
    "def pdot_nmcv(M_wd_solar, log10_Mdot):\n",
    "    \"\"\"Predicted Pdot for the nmCV case (disk extends to WD surface, spin-up only).\"\"\"\n",
    "    M = M_wd_solar * Msun\n",
    "    Mdot = 10**log10_Mdot\n",
    "    R = get_R(M_wd_solar)\n",
    "    I = get_I(M_wd_solar)\n",
    "    tau = Mdot * np.sqrt(G * M * R)\n",
    "    return -P**2 * tau / (2 * np.pi * I)\n",
    "\n",
    "\n",
    "def pdot_ip(M_wd_solar, log10_Mdot, log10_mu):\n",
    "    \"\"\"Predicted Pdot for IP case (piecewise disk-magnetosphere torque).\n",
    "\n",
    "    Accretion phase (r_m <= r_co): Eq 9 of Bhattacharyya & Chakrabarty (2017).\n",
    "    Propeller phase (r_m > r_co): Eq 10 with efficiency `eta` (module-level const).\n",
    "    Returns NaN if r_m <= R_WD (unphysical).\n",
    "    \"\"\"\n",
    "    M = M_wd_solar * Msun\n",
    "    Mdot = 10**log10_Mdot\n",
    "    mu = 10**log10_mu\n",
    "    R = get_R(M_wd_solar)\n",
    "    I = get_I(M_wd_solar)\n",
    "\n",
    "    r_m = xi * (mu**4 / (2 * G * M * Mdot**2))**(1.0/7.0)\n",
    "    r_co = (G * M * P**2 / (4 * np.pi**2))**(1.0/3.0)\n",
    "\n",
    "    if r_m <= R:\n",
    "        return np.nan\n",
    "\n",
    "    if r_m <= r_co:\n",
    "        x = r_m / r_co\n",
    "        tau_acc = Mdot * np.sqrt(G * M * r_m)\n",
    "        tau_mag = mu**2 / (9 * r_m**3) * (2 * x**3 - 6 * x**1.5 + 3)\n",
    "    else:\n",
    "        tau_acc = -eta * Mdot * np.sqrt(G * M * r_m)\n",
    "        tau_mag = -mu**2 / (9 * r_m**3) * (3 - 2 * (r_co / r_m)**1.5)\n",
    "\n",
    "    return -P**2 * (tau_acc + tau_mag) / (2 * np.pi * I)\n",
    "\n",
    "\n",
    "# =====================================================\n",
    "# Band-correction factor for the bolometric -> 0.3-12 keV conversion\n",
    "# =====================================================\n",
    "\n",
    "def f_band(kT_keV):\n",
    "    \"\"\"Fraction of bolometric thermal-bremsstrahlung luminosity in LX_BAND_LO..LX_BAND_HI.\n",
    "\n",
    "    Single-temperature bremsstrahlung with Gaunt factor ~1:\n",
    "        dL/dE ~ exp(-E/kT)  ->  L(E1,E2)/L_bol = exp(-E1/kT) - exp(-E2/kT).\n",
    "    Evaluated at the predicted kT so the correction is self-consistent with the\n",
    "    modeled spectral shape. For a multi-T cooling flow this is an approximation\n",
    "    (lower-T components emit more softly); for kT_max ~ 15 keV and the 0.3-12 keV\n",
    "    band, the hot bremsstrahlung component dominates and the approximation is\n",
    "    accurate to better than ~10%.\n",
    "    \"\"\"\n",
    "    return np.exp(-LX_BAND_LO / kT_keV) - np.exp(-LX_BAND_HI / kT_keV)\n",
    "\n",
    "\n",
    "# =====================================================\n",
    "# Spectral forward models\n",
    "# =====================================================\n",
    "\n",
    "def kT_nmcv(M_wd_solar):\n",
    "    \"\"\"Predicted maximum shock temperature for nmCV [keV].\n",
    "\n",
    "    Yu+2018 empirical relation for boundary-layer CVs:\n",
    "        kT_max = (3/16) * alpha * mu_mol * m_H * GM/R\n",
    "    where alpha = 0.646 maps the hydrodynamic virial temperature onto the\n",
    "    MKCFLOW kT_max parameter that kT_obs was measured with.\n",
    "    \"\"\"\n",
    "    M = M_wd_solar * Msun\n",
    "    R = get_R(M_wd_solar)\n",
    "    kT_erg = (3.0 / 16.0) * alpha_Yu * mu_mol * m_H * G * M / R\n",
    "    return kT_erg / keV_to_erg\n",
    "\n",
    "\n",
    "def LX_nmcv(M_wd_solar, log10_Mdot):\n",
    "    \"\"\"Predicted 0.3-12 keV X-ray luminosity for nmCV [erg/s].\n",
    "\n",
    "    L_X = f_band(kT) * GM * Mdot / R, where f_band converts the bolometric\n",
    "    boundary-layer accretion luminosity to the observed energy band.\n",
    "    \"\"\"\n",
    "    M = M_wd_solar * Msun\n",
    "    R = get_R(M_wd_solar)\n",
    "    Mdot = 10**log10_Mdot\n",
    "    L_bol = G * M * Mdot / R\n",
    "    return f_band(kT_nmcv(M_wd_solar)) * L_bol\n",
    "\n",
    "\n",
    "def kT_ip(M_wd_solar, log10_Mdot, log10_mu):\n",
    "    \"\"\"Predicted shock temperature for IP [keV].\n",
    "\n",
    "    Compact shock at the WD surface:\n",
    "        kT = (3/8) * mu_mol * m_H * v_ff^2,  v_ff^2 = 2GM(1/R - 1/r_m).\n",
    "    Returns NaN if r_m <= R_WD (unphysical) or r_m > r_co (propeller regime:\n",
    "    accretion is centrifugally suppressed, no standing shock on the WD).\n",
    "\n",
    "    Ignores finite shock height h_s. For CJ2056 (h_s/R ~ 20%) this\n",
    "    overestimates kT by ~10-20%, within the observational uncertainty on kT_obs.\n",
    "    \"\"\"\n",
    "    M = M_wd_solar * Msun\n",
    "    R = get_R(M_wd_solar)\n",
    "    Mdot = 10**log10_Mdot\n",
    "    mu = 10**log10_mu\n",
    "    r_m = xi * (mu**4 / (2 * G * M * Mdot**2))**(1.0/7.0)\n",
    "    r_co = (G * M * P**2 / (4 * np.pi**2))**(1.0/3.0)\n",
    "    if r_m <= R or r_m > r_co:\n",
    "        return np.nan\n",
    "    vff2 = 2 * G * M * (1.0 / R - 1.0 / r_m)\n",
    "    kT_erg = (3.0 / 8.0) * mu_mol * m_H * vff2\n",
    "    return kT_erg / keV_to_erg\n",
    "\n",
    "\n",
    "def LX_ip(M_wd_solar, log10_Mdot, log10_mu):\n",
    "    \"\"\"Predicted 0.3-12 keV X-ray luminosity for IP [erg/s].\n",
    "\n",
    "    L_X = f_band(kT) * GM * Mdot * (1/R - 1/r_m), accounting for the finite\n",
    "    magnetospheric radius (accretion energy released only from r_m to R_WD)\n",
    "    and the bolometric -> band-limited conversion.\n",
    "\n",
    "    Returns NaN if r_m <= R_WD or r_m > r_co (propeller regime: no accretion\n",
    "    shock on the WD, so the band-limited accretion luminosity is undefined).\n",
    "    \"\"\"\n",
    "    M = M_wd_solar * Msun\n",
    "    R = get_R(M_wd_solar)\n",
    "    Mdot = 10**log10_Mdot\n",
    "    mu = 10**log10_mu\n",
    "    r_m = xi * (mu**4 / (2 * G * M * Mdot**2))**(1.0/7.0)\n",
    "    r_co = (G * M * P**2 / (4 * np.pi**2))**(1.0/3.0)\n",
    "    if r_m <= R or r_m > r_co:\n",
    "        return np.nan\n",
    "    vff2 = 2 * G * M * (1.0 / R - 1.0 / r_m)\n",
    "    kT = (3.0 / 8.0) * mu_mol * m_H * vff2 / keV_to_erg\n",
    "    L_bol = G * M * Mdot * (1.0 / R - 1.0 / r_m)\n",
    "    return f_band(kT) * L_bol\n",
    "\n",
    "\n",
    "# --- Sanity checks ---\n",
    "print(\"=== Pdot checks ===\")\n",
    "print(f\"nmCV(0.935, 15): Pdot = {pdot_nmcv(0.935, 15):.3e}\")\n",
    "print(f\"IP(0.815, 15, 30.3): Pdot = {pdot_ip(0.815, 15, 30.3):.3e}\")\n",
    "\n",
    "print(\"\\n=== f_band checks ===\")\n",
    "print(f\"f_band(16.3 keV): {f_band(16.3):.3f}   (0.3-12 keV fraction at kT_obs)\")\n",
    "print(f\"f_band(10 keV):   {f_band(10.0):.3f}\")\n",
    "print(f\"f_band(30 keV):   {f_band(30.0):.3f}\")\n",
    "\n",
    "print(\"\\n=== kT checks ===\")\n",
    "print(f\"nmCV kT(0.9): {kT_nmcv(0.9):.1f} keV  (expect ~15-20 keV)\")\n",
    "print(f\"IP kT(0.8, 14.5, 30.0): {kT_ip(0.8, 14.5, 30.0):.1f} keV  (accretion regime)\")\n",
    "kT_prop = kT_ip(0.8, 14.5, 31.0)\n",
    "print(f\"IP kT(0.8, 14.5, 31.0): {kT_prop}   (propeller regime -> NaN expected)\")\n",
    "\n",
    "print(\"\\n=== L_X checks (band-corrected) ===\")\n",
    "print(f\"nmCV L_X(0.9, 14.5): {LX_nmcv(0.9, 14.5):.2e} erg/s  (expect ~5e30-1e31)\")\n",
    "print(f\"IP L_X(0.8, 14.5, 30.0): {LX_ip(0.8, 14.5, 30.0):.2e} erg/s\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Priors and Likelihood\n",
    "\n",
    "**Priors**: Broad population-based priors, independent of this source's spectral fit (breaks the $M$-$B$-$\\dot M$ covariance that informative spectral priors would introduce).\n",
    "- $M_{\\rm WD}$: $\\mathcal{N}(0.83, 0.20)$ (Pala+2022, volume-limited CV sample), clipped to WD table range\n",
    "- $\\log_{10}\\dot{M}$: $\\mathcal{U}(13, 17)$ (flat in log-space, spans sub-luminous nmCV through luminous IP)\n",
    "- $\\log_{10}\\mu$ (IP only): $\\mathcal{U}(29, 35)$\n",
    "\n",
    "**Likelihood**: Three observational constraints enter as independent Gaussians:\n",
    "$$\\ln \\mathcal{L} = -\\frac{1}{2}\\left[\\left(\\frac{\\dot{P}_{\\rm obs} - \\dot{P}_{\\rm pred}}{\\sigma_{\\dot{P}}}\\right)^2 + \\left(\\frac{L_{X,\\rm obs} - L_{X,\\rm pred}}{\\sigma_{L_X}}\\right)^2 + \\left(\\frac{kT_{\\rm obs} - kT_{\\rm pred}}{\\sigma_{kT}}\\right)^2\\right]$$\n",
    "\n",
    "For the IP model, parameter combinations that drive the system into the propeller regime ($r_m > r_{\\rm co}$) yield NaN from $kT_{\\rm ip}$ / $L_{X,\\rm ip}$ and are rejected (log-likelihood $= -\\infty$). This is the physically-correct treatment: the observation of a shock at $kT_{\\rm obs}$ and accretion luminosity at $L_{X,\\rm obs}$ directly rules out pure propeller."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================\n",
    "# nmCV model: 2 parameters [M_wd, log10_Mdot]\n",
    "# =====================================================\n",
    "\n",
    "# Population mass prior (Pala+2022)\n",
    "POP_M_MU, POP_M_SIG = 0.83, 0.20\n",
    "\n",
    "# log10(Mdot) flat prior\n",
    "LOGMDOT_LO, LOGMDOT_HI = 13.0, 17.0\n",
    "\n",
    "\n",
    "def prior_transform_nmcv(u):\n",
    "    \"\"\"Map unit cube [0,1]^2 -> nmCV parameter space.\"\"\"\n",
    "    theta = np.empty(2)\n",
    "    theta[0] = norm.ppf(u[0], loc=POP_M_MU, scale=POP_M_SIG)\n",
    "    theta[0] = np.clip(theta[0], M_min_table + 0.001, M_max_table - 0.001)\n",
    "    theta[1] = LOGMDOT_LO + u[1] * (LOGMDOT_HI - LOGMDOT_LO)\n",
    "    return theta\n",
    "\n",
    "\n",
    "def log_likelihood_nmcv(theta):\n",
    "    \"\"\"Log-likelihood for nmCV model with Pdot + L_X + kT.\"\"\"\n",
    "    M_wd, log_Mdot = theta\n",
    "    if M_wd <= M_min_table or M_wd >= M_max_table:\n",
    "        return -1e100\n",
    "    \n",
    "    Pdot_pred = pdot_nmcv(M_wd, log_Mdot)\n",
    "    kT_pred = kT_nmcv(M_wd)\n",
    "    LX_pred = LX_nmcv(M_wd, log_Mdot)\n",
    "    \n",
    "    chi2  = ((Pdot_obs - Pdot_pred) / sigma_Pdot)**2\n",
    "    chi2 += ((kT_obs - kT_pred) / sigma_kT)**2\n",
    "    chi2 += ((L_X_obs - LX_pred) / sigma_LX)**2\n",
    "    return -0.5 * chi2\n",
    "\n",
    "\n",
    "# =====================================================\n",
    "# IP model: 3 parameters [M_wd, log10_Mdot, log10_mu]\n",
    "# =====================================================\n",
    "\n",
    "LOGMU_LO, LOGMU_HI = 29.0, 35.0\n",
    "\n",
    "\n",
    "def prior_transform_ip(u):\n",
    "    \"\"\"Map unit cube [0,1]^3 -> IP parameter space.\"\"\"\n",
    "    theta = np.empty(3)\n",
    "    theta[0] = norm.ppf(u[0], loc=POP_M_MU, scale=POP_M_SIG)\n",
    "    theta[0] = np.clip(theta[0], M_min_table + 0.001, M_max_table - 0.001)\n",
    "    theta[1] = LOGMDOT_LO + u[1] * (LOGMDOT_HI - LOGMDOT_LO)\n",
    "    theta[2] = LOGMU_LO + u[2] * (LOGMU_HI - LOGMU_LO)\n",
    "    return theta\n",
    "\n",
    "\n",
    "def log_likelihood_ip(theta):\n",
    "    \"\"\"Log-likelihood for IP model with Pdot + L_X + kT.\"\"\"\n",
    "    M_wd, log_Mdot, log_mu = theta\n",
    "    if M_wd <= M_min_table or M_wd >= M_max_table:\n",
    "        return -1e100\n",
    "    \n",
    "    Pdot_pred = pdot_ip(M_wd, log_Mdot, log_mu)\n",
    "    if np.isnan(Pdot_pred):\n",
    "        return -1e100\n",
    "    \n",
    "    kT_pred = kT_ip(M_wd, log_Mdot, log_mu)\n",
    "    if np.isnan(kT_pred) or kT_pred <= 0:\n",
    "        return -1e100\n",
    "    \n",
    "    LX_pred = LX_ip(M_wd, log_Mdot, log_mu)\n",
    "    if np.isnan(LX_pred) or LX_pred <= 0:\n",
    "        return -1e100\n",
    "    \n",
    "    chi2  = ((Pdot_obs - Pdot_pred) / sigma_Pdot)**2\n",
    "    chi2 += ((kT_obs - kT_pred) / sigma_kT)**2\n",
    "    chi2 += ((L_X_obs - LX_pred) / sigma_LX)**2\n",
    "    return -0.5 * chi2"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Nested Sampling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Running IP nested sampling (3 params, with L_X + kT constraints)...\n"
     ]
    },
